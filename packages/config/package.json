{
  "name": "@switchboard/config",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "switchboard.yaml: load, validate, and apply reps, teams, forms, and rules.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.mjs --external:pg --external:drizzle-orm --external:yaml --external:zod --log-level=warning",
    "test": "vitest run"
  },
  "dependencies": {
    "@switchboard/core": "*",
    "@switchboard/db": "*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.13.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
