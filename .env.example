# Switchboard environment configuration — copy to .env and fill in.
# Never commit real secrets; everything is injected via environment variables.
#
# `docker compose up` reads this file automatically and overrides its demo
# defaults with it (see docker-compose.yml).

# Postgres (matches docker-compose.yml defaults; inside compose use host `db`)
DATABASE_URL=postgres://switchboard:switchboard@localhost:5432/switchboard

# Seed the demo org, rule set, teams, and the /f/book-a-demo form on start.
# Set to false for a clean instance (compose default: true).
# SEED_DEMO_DATA=true

# Admin login (Auth.js) — required for /integrations and /routing-log.
# The single admin account; nothing is stored in the database.
# ADMIN_EMAIL=admin@yourcompany.com
# ADMIN_PASSWORD=
# Session signing secret. Generate: openssl rand -hex 32
# AUTH_SECRET=

# Google Calendar OAuth (self-hosters provide their own client; see docs/decisions.md)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AES-256-GCM key for encrypting stored OAuth tokens. Generate: openssl rand -hex 32
# TOKEN_ENCRYPTION_KEY=

# Optional automation key for scripted CSV exports of the routing log
# (GET /api/decisions/export?key=…). Browser access uses the admin login.
# Generate: openssl rand -hex 32
# ADMIN_SETUP_KEY=

# Base URL used for OAuth redirect URIs (default: http://localhost:3000)
# APP_BASE_URL=

# Single-org mode; must match an orgs.slug (default: the seed org)
# ORG_SLUG=

# HubSpot OAuth
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=

# Confirmation email + speed-to-lead alerts (bring your own SMTP)
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_FROM="Acme <no-reply@acme.example>"

# Plain booking link offered by email when Google Calendar event creation
# fails at booking time (e.g. your Cal.com/Calendly link for that rep)
# FALLBACK_BOOKING_URL=

# Speed-to-lead alerts: a lead routed to a rep but unbooked after this many
# minutes notifies the rep (Slack first, then email; both optional)
# SPEED_TO_LEAD_MINUTES=5
# SLACK_WEBHOOK_URL=

# Optional enrichment webhook (abuse protection / data append)
# ENRICHMENT_WEBHOOK_URL=
