# Switchboard environment configuration — copy to .env and fill in.
# Never commit real secrets; everything is injected via environment variables.

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgres://switchboard:switchboard@localhost:5432/switchboard

# Admin auth (set later tasks)
# AUTH_SECRET=

# Google Calendar OAuth (self-hosters provide their own client; see docs/decisions.md)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AES-256-GCM key for encrypting stored OAuth tokens. Generate: openssl rand -hex 32
# TOKEN_ENCRYPTION_KEY=

# Interim admin key guarding the integrations OAuth handshake until Auth.js lands.
# Generate: openssl rand -hex 32
# ADMIN_SETUP_KEY=

# Base URL used for OAuth redirect URIs (default: http://localhost:3000)
# APP_BASE_URL=

# Single-org mode until admin auth lands; must match an orgs.slug (default: the seed org)
# ORG_SLUG=

# HubSpot OAuth
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=

# Confirmation email + speed-to-lead alerts (bring your own SMTP)
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_FROM="Acme <no-reply@acme.example>"

# Plain booking link offered by email when Google Calendar event creation
# fails at booking time (e.g. your Cal.com/Calendly link for that rep)
# FALLBACK_BOOKING_URL=

# Speed-to-lead alerts (task: Slack/email notifications)
# SLACK_WEBHOOK_URL=

# Optional enrichment webhook (abuse protection / data append)
# ENRICHMENT_WEBHOOK_URL=
