# Switchboard environment: copy to .env and fill in what you need.
# docker compose, the web server, and the npm scripts all read .env; real
# environment variables always take precedence. Never commit your .env.
# Full reference: docs/self-hosting.md#configuration-reference

# --- Database --------------------------------------------------------------
# Outside Docker. (Compose sets its own, pointing at the bundled Postgres.)
DATABASE_URL=postgres://switchboard:switchboard@localhost:5432/switchboard

# --- Admin and secrets -----------------------------------------------------
# With Docker, any of these left empty is generated on first start and kept
# in the appdata volume (the admin password is printed once in the logs).
# Outside Docker, set them all. Generate secrets with: openssl rand -hex 32
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=              # at least 12 characters
# AUTH_SECRET=                 # at least 32 characters
# TOKEN_ENCRYPTION_KEY=        # exactly 64 hex characters

# --- Public URL and proxies ------------------------------------------------
# The URL people use to reach Switchboard (OAuth redirects, emailed links).
# APP_BASE_URL=https://switchboard.yourcompany.com
# Number of reverse proxies in front of the app (Caddy/nginx = 1).
# TRUSTED_PROXY_HOPS=1

# --- Your setup ------------------------------------------------------------
# Reps, teams, forms, and rules: see switchboard.example.yaml.
# SWITCHBOARD_CONFIG=./switchboard.yaml
# Load the demo when there's no config file (docker compose default: true).
# SEED_DEMO_DATA=false

# --- Google Calendar (each rep connects their own) ------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- HubSpot ---------------------------------------------------------------
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=

# --- Email and alerts ------------------------------------------------------
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_FROM="Acme <no-reply@acme.example>"
# SLACK_WEBHOOK_URL=
# SPEED_TO_LEAD_MINUTES=5
# Booking link included in confirmations if the calendar event couldn't be created.
# FALLBACK_BOOKING_URL=

# --- Forms -----------------------------------------------------------------
# Sites allowed to embed your forms (space-separated). Default: any site.
# EMBED_ALLOWED_ORIGINS="https://yourcompany.com https://www.yourcompany.com"
# Optional Cloudflare Turnstile bot check on forms.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Automation ------------------------------------------------------------
# Bearer token for scripted CSV exports: Authorization: Bearer <key>
# ADMIN_SETUP_KEY=
